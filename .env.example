# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL (persistent volume: devopsportal-postgres-data — never removed by
# normal `docker compose down` / restart; only `down -v` removes it).
POSTGRES_DB=devopsportal
POSTGRES_USER=devopsportal
POSTGRES_PASSWORD=change_me_to_a_strong_password

# API
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# Frontend (nginx-served SPA, reverse-proxies /api to the api container —
# no separate secrets needed here)
FRONTEND_PORT=8081

# JWT signing key — generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change_me_to_a_random_secret_at_least_32_bytes_long
JWT_ISSUER=devops-portal
JWT_AUDIENCE=devops-portal
JWT_EXPIRY_MINUTES=480

# Secret-store encryption key (Phase 7) — encrypts secret reference values at
# rest (AES-256-GCM). Generate with: openssl rand -base64 48
# Rotating this key requires re-encrypting every stored SecretValueRecord —
# there is no key-rotation tooling yet (see PROJECT_STATE.md's Phase 7
# Known limitations); changing it after secrets exist makes them unreadable.
SECRET_ENCRYPTION_KEY=change_me_to_a_different_random_secret_at_least_32_bytes_long

# Bootstrap admin account, created only if no users exist yet.
# Leave ADMIN_INITIAL_PASSWORD empty to have a random password generated and
# printed once to the API container logs on first startup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_INITIAL_PASSWORD=

# Portal's own public URL — used only to build deep links in notification
# emails (e.g. "Review at: https://portal.example.com/promotions/..."). Leave
# empty and notifications still send, just without a clickable link.
PORTAL_BASE_URL=

# SMTP (Phase 8 notifications: approval requests, deployment started/
# succeeded/failed, rollback completed/failed). Leave SMTP_HOST empty and the
# portal stays fully functional — notifications just aren't emailed (a
# warning is logged); nothing here is ever required to start the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=DevOps Portal
