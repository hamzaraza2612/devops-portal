# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL (persistent volume: devopsportal-postgres-data — never removed by
# normal `docker compose down` / restart; only `down -v` removes it).
POSTGRES_DB=devopsportal
POSTGRES_USER=devopsportal
POSTGRES_PASSWORD=change_me_to_a_strong_password

# API
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# JWT signing key — generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change_me_to_a_random_secret_at_least_32_bytes_long
JWT_ISSUER=devops-portal
JWT_AUDIENCE=devops-portal
JWT_EXPIRY_MINUTES=480

# Bootstrap admin account, created only if no users exist yet.
# Leave ADMIN_INITIAL_PASSWORD empty to have a random password generated and
# printed once to the API container logs on first startup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_INITIAL_PASSWORD=
